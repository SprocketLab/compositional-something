# Default-only run-length task settings for adaptive candidate training.
# Usually source after adaptive_candidate_base.env.

: "${TASK:=run_length}"
: "${INITIAL_MIN_SIZE:=8}"
: "${INITIAL_MAX_SIZE:=16}"
: "${FRONTIER_MAX_SIZE:=48}"
: "${INITIAL_TRAIN_PER_SIZE:=50000}"
: "${CANDIDATE_TRAIN_PER_SIZE:=2000}"
: "${INITIAL_EVAL_PER_SIZE:=50}"
: "${EVAL_PER_SIZE:=100}"
: "${COMPOSED_EVAL_PER_SIZE:=100}"
: "${TARGET_MODE:=run_state}"
: "${SYMBOL_ALPHABET_SIZE:=2}"
: "${DECODE_MAX_NEW_TOKENS:=32}"
: "${CONTROLLER_SEED_WORKER_TIME_LIMIT:=03:00:00}"
: "${CANDIDATE_ARRAY_TIME_LIMIT:=03:00:00}"
