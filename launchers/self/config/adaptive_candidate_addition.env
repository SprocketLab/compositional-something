# Default-only addition task settings for adaptive candidate training.
# Usually source after adaptive_candidate_base.env.

: "${TASK:=addition}"
: "${INITIAL_MIN_SIZE:=3}"
: "${INITIAL_MAX_SIZE:=7}"
: "${FRONTIER_MAX_SIZE:=31}"
: "${INITIAL_TRAIN_PER_SIZE:=5000}"
: "${CANDIDATE_TRAIN_PER_SIZE:=5000}"
: "${INITIAL_EVAL_PER_SIZE:=50}"
: "${EVAL_PER_SIZE:=100}"
: "${COMPOSED_EVAL_PER_SIZE:=100}"
: "${DECODE_MAX_NEW_TOKENS:=48}"
: "${CONTROLLER_SEED_WORKER_TIME_LIMIT:=02:00:00}"
