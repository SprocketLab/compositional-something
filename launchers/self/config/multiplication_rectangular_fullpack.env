# Default settings for submit_multiplication_rectangular_fullpack_mig.sh.
#
# Override variables in the environment, or point MULT_RECT_FULLPACK_CONFIG at
# another file, to adjust this pack without editing the submitter.

: "${LAUNCHER:=${ROOT_DIR}/launchers/self/run_multiplication_rectangular_self_improvement_mig.sbatch}"
: "${SEED_MODEL:=${ROOT_DIR}/artifacts/models/multiplication_rectangular_seed_best}"
: "${MULT_RECT_FULLPACK_BASELINES_RAW:=${BASELINES:-short_only direct compose compose_corrupt}}"
: "${TRAIN_BATCH_SIZE:=256}"
: "${EVAL_BATCH_SIZE:=256}"
: "${SEED_REPLAY_TRAIN_PER_PARTITION:=2000}"
: "${EXPAND_TRAIN_PER_PARTITION:=2000}"
: "${FRONTIER_ROW_PROFILE:=uniform}"
: "${INITIAL_MAX_B_DIGITS:=8}"
: "${EXPAND_B_DIGITS:=2}"
: "${NUM_EXPAND_ROUNDS:=4}"
: "${HELDOUT_PER_PARTITION:=200}"
: "${LEARNING_RATE:=}"
: "${MAX_STEPS:=}"
: "${SAVE_MODEL:=1}"
: "${SEED:=0}"
: "${DRY_RUN:=0}"
