# Default top-level settings for the Figure 2 aggressive recipe workflow.
#
# Task-specific schedule/model defaults stay in figure2_run_length.env. Override
# these variables in the environment, or point FIGURE2_RECIPE_CONFIG at another
# file, to adjust the run selector or baseline matrix without editing the
# runner/submitter.

: "${STAGE:=all}"
: "${TASKS:=run_length}"
: "${DEVICE_TARGET:=local_a100_40gb}"
: "${DRY_RUN:=0}"
: "${FIGURE2_RECIPE_BASELINES_RAW:=${BASELINES:-short_only direct compose compose_corrupt}}"
