# Default matrix for submit_multiplication_rectangular_seed_sweep_mig.sh.
#
# Override these variables in the environment or point SEED_SWEEP_CONFIG at a
# different file to run a smaller/larger sweep without editing the launcher.

STAGE0_TRAIN_PER_PARTITION="${STAGE0_TRAIN_PER_PARTITION:-10}"
STAGE0_MAX_STEPS="${STAGE0_MAX_STEPS:-1000}"
STAGE1_TRAIN_COUNTS_RAW="${STAGE1_TRAIN_COUNTS_RAW:-25000 50000}"
STAGE1_LRS_RAW="${STAGE1_LRS_RAW:-2e-5 5e-5 1e-4}"
STAGE3_TRAIN_PER_PARTITION="${STAGE3_TRAIN_PER_PARTITION:-100000}"
