# Default baseline rows for submit_run_length_alpha10_baseline_pack_mig.sh.
#
# Rows are:
#   baseline:pseudo_label_mode:guarded_compose_rule
# Override RUN_LENGTH_ALPHA10_BASELINE_ROWS_RAW or point
# RUN_LENGTH_ALPHA10_BASELINE_CONFIG at another file to adjust the pack without
# editing the submitter.

RUN_LENGTH_ALPHA10_BASELINE_ROWS_RAW="${RUN_LENGTH_ALPHA10_BASELINE_ROWS_RAW:-direct:direct:none unfiltered_compose:compose:run_length_unfiltered_pair guarded_compose:compose:run_length_no_boundary_continue}"
