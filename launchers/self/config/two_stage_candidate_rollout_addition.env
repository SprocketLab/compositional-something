# Qwen3.5-2B addition pilot: cheap action screening plus full winner confirmation.
# Source after adaptive_candidate_base.env. These assignments intentionally
# override generic launcher defaults; attempt budget and wall time stay external.

CANDIDATE_TRAINING_MODE=two_stage
NUM_CANDIDATES=8
FORCE_UNIQUE_PROPOSALS=1
PROPOSAL_TEMPERATURE=0.9
PROPOSAL_TOP_P=0.95
PROPOSAL_PROMPT_ACTION_HISTORY=1
PROPOSAL_PROMPT_ACTION_HISTORY_MAX_ITEMS=5

CANDIDATE_TRAIN_PER_SIZE=5000
ROLLOUT_TRAIN_PER_SIZE=512
ROLLOUT_EVAL_PER_SIZE=20
EVAL_PER_SIZE=100
MAX_STEPS=25
SELECTED_MAX_STEPS=0
NUM_EPOCHS=1
TRAIN_BATCH_SIZE=16
EVAL_BATCH_SIZE=128
GRAD_ACCUM_STEPS=1
LEARNING_RATE=5e-6

CANDIDATE_EXECUTION_MODE=local_parallel
CANDIDATE_LOCAL_PARALLELISM=2
CANDIDATE_LOCAL_PACK_SIZE=2
CANDIDATE_LOCAL_CACHE_BASE_STATE=1

PROPOSAL_GRPO_STEPS=1
PROPOSAL_GRPO_REWARD_MODE=outcome
PROPOSAL_GRPO_ZERO_VARIANCE=skip
PROPOSAL_GRPO_LEARNING_RATE=5e-6
PROPOSAL_GRPO_KL_COEF=0.01
PROPOSAL_GRPO_NOVELTY_BONUS_BETA=0.05
PROPOSAL_UPDATE_MICROBATCH_SIZE=4
PROPOSAL_UPDATE_ACCUMULATION_STEPS=2
PROPOSAL_OBSERVATION_LOSS_WEIGHT=0.2
PROPOSAL_FORMAT_LOSS_WEIGHT=0.02
SOURCE_ADMISSION_TARGET_ACCURACY_THRESHOLD=0.80

SYNTHETIC_PROPOSAL_SFT=0
SYNTHETIC_PROPOSAL_SFT_EXAMPLES=0
TREAT_SEED_AS_ROUND_ZERO=1
KEEP_FINAL_MODEL_CHECKPOINT=1
PLAN_LOG_PATH="${ROOT_DIR}/plan/260716-two-stage-candidate-rollout-speed.md"
