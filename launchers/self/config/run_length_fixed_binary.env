# Default settings for submit_run_length_fixed_binary_mig.sh.
#
# Override variables in the environment, or point RUN_LENGTH_FIXED_BINARY_CONFIG
# at another file, to adjust this pack without editing the submitter.

: "${RUN_LENGTH_SEED_MODEL:=${ROOT_DIR}/artifacts/models/run_length_recipe_seed_best}"
: "${ALPHA10_SEED_MODEL:=${ROOT_DIR}/artifacts/runs/run_length_multisymbol_pair_alpha10_seed50k_steps15k_20260423_123229/seed/model}"
: "${CONTROLLER_PARTITION:=cpu}"

: "${RUN_LENGTH_FIXED_BINARY_PAPER_STAGE:=pilot}"
: "${RUN_LENGTH_FIXED_BINARY_PAPER_TASKS:=run_length}"
: "${RUN_LENGTH_FIXED_BINARY_PAPER_EXPAND_ROUNDS:=8}"
: "${RUN_LENGTH_FIXED_BINARY_PAPER_EXPAND_NUM_BITS:=4}"
: "${RUN_LENGTH_FIXED_BINARY_PAPER_EXPAND_TRAIN_PER_BIT:=1200}"
: "${RUN_LENGTH_FIXED_BINARY_PAPER_TRAIN_BATCH_SIZE:=128}"
: "${RUN_LENGTH_FIXED_BINARY_PAPER_EVAL_BATCH_SIZE:=128}"
: "${RUN_LENGTH_FIXED_BINARY_PAPER_COMPOSITION_PATH_MODE:=fixed_binary}"
: "${RUN_LENGTH_FIXED_BINARY_PAPER_RUN_PILOT_GATE:=0}"
: "${RUN_LENGTH_FIXED_BINARY_PAPER_JOB_NAME:=rl-fb-paper}"
: "${RUN_LENGTH_FIXED_BINARY_PAPER_PARTITION:=mig}"
: "${RUN_LENGTH_FIXED_BINARY_PAPER_GRES:=gpu:1g.10gb:1}"
: "${RUN_LENGTH_FIXED_BINARY_PAPER_CPUS:=1}"
: "${RUN_LENGTH_FIXED_BINARY_PAPER_MEM:=64G}"
: "${RUN_LENGTH_FIXED_BINARY_PAPER_TIME:=48:00:00}"

: "${RUN_LENGTH_FIXED_BINARY_ALPHA_BASELINE:=guarded_compose}"
: "${RUN_LENGTH_FIXED_BINARY_ALPHA_TEMPLATE_REL:=template/run_length/pilot/guarded_compose}"
: "${RUN_LENGTH_FIXED_BINARY_ALPHA_TEMPLATE_JOB_NAME:=rl-fb-a10-template}"
: "${RUN_LENGTH_FIXED_BINARY_ALPHA_TEMPLATE_PARTITION:=mig}"
: "${RUN_LENGTH_FIXED_BINARY_ALPHA_TEMPLATE_GRES:=gpu:1g.10gb:1}"
: "${RUN_LENGTH_FIXED_BINARY_ALPHA_TEMPLATE_CPUS:=1}"
: "${RUN_LENGTH_FIXED_BINARY_ALPHA_TEMPLATE_MEM:=64G}"
: "${RUN_LENGTH_FIXED_BINARY_ALPHA_TEMPLATE_TIME:=12:00:00}"

: "${RUN_LENGTH_FIXED_BINARY_ALPHA_TARGET_MODE:=symbol_run_pair}"
: "${RUN_LENGTH_FIXED_BINARY_ALPHA_COMPOSE_ARITY:=exact2}"
: "${RUN_LENGTH_FIXED_BINARY_ALPHA_COMPOSITION_PATH_MODE:=fixed_binary}"
: "${RUN_LENGTH_FIXED_BINARY_ALPHA_RECIPE:=algorithmic_self_improve_v1}"
: "${RUN_LENGTH_FIXED_BINARY_ALPHA_SYMBOL_ALPHABET_SIZE:=10}"
: "${RUN_LENGTH_FIXED_BINARY_ALPHA_INITIAL_MIN_BITS:=6}"
: "${RUN_LENGTH_FIXED_BINARY_ALPHA_INITIAL_MAX_BITS:=10}"
: "${RUN_LENGTH_FIXED_BINARY_ALPHA_INITIAL_TRAIN_PER_BIT:=50000}"
: "${RUN_LENGTH_FIXED_BINARY_ALPHA_INITIAL_EVAL_PER_BIT:=100}"
: "${RUN_LENGTH_FIXED_BINARY_ALPHA_FRONTIER_MIN_BITS:=12}"
: "${RUN_LENGTH_FIXED_BINARY_ALPHA_NUM_EXPAND_ROUNDS:=7}"
: "${RUN_LENGTH_FIXED_BINARY_ALPHA_EXPAND_NUM_BITS:=9}"
: "${RUN_LENGTH_FIXED_BINARY_ALPHA_EXPAND_TRAIN_PER_BIT:=2000}"
: "${RUN_LENGTH_FIXED_BINARY_ALPHA_EVAL_PER_BIT:=100}"
: "${RUN_LENGTH_FIXED_BINARY_ALPHA_COMPOSED_EVAL_PER_BIT:=100}"
: "${RUN_LENGTH_FIXED_BINARY_ALPHA_PSEUDO_LABEL_MODE:=compose}"
: "${RUN_LENGTH_FIXED_BINARY_ALPHA_GUARDED_COMPOSE_RULE:=run_length_no_boundary_continue}"
: "${RUN_LENGTH_FIXED_BINARY_ALPHA_TRAIN_BATCH_SIZE:=256}"
: "${RUN_LENGTH_FIXED_BINARY_ALPHA_EVAL_BATCH_SIZE:=256}"
: "${RUN_LENGTH_FIXED_BINARY_ALPHA_TEMPLATE_SEED:=42}"
: "${RUN_LENGTH_FIXED_BINARY_ALPHA_WARMUP_STEPS:=500}"

: "${RUN_LENGTH_FIXED_BINARY_BEAM_JOB_NAME:=rl-fb-a10-beam}"
: "${RUN_LENGTH_FIXED_BINARY_BEAM_PARTITION:=${CONTROLLER_PARTITION}}"
: "${RUN_LENGTH_FIXED_BINARY_BEAM_GRES:=}"
: "${RUN_LENGTH_FIXED_BINARY_BEAM_CPUS:=1}"
: "${RUN_LENGTH_FIXED_BINARY_BEAM_MEM:=8G}"
: "${RUN_LENGTH_FIXED_BINARY_BEAM_TIME:=36:00:00}"
: "${RUN_LENGTH_FIXED_BINARY_BEAM_MAX_ROUND:=${RUN_LENGTH_FIXED_BINARY_ALPHA_NUM_EXPAND_ROUNDS}}"
: "${RUN_LENGTH_FIXED_BINARY_BEAM_WARMUP_STEPS:=${RUN_LENGTH_FIXED_BINARY_ALPHA_WARMUP_STEPS}}"
: "${RUN_LENGTH_FIXED_BINARY_BEAM_TRAIN_BATCH_SIZE:=${RUN_LENGTH_FIXED_BINARY_ALPHA_TRAIN_BATCH_SIZE}}"
: "${RUN_LENGTH_FIXED_BINARY_BEAM_EVAL_BATCH_SIZE:=${RUN_LENGTH_FIXED_BINARY_ALPHA_EVAL_BATCH_SIZE}}"
: "${RUN_LENGTH_FIXED_BINARY_BEAM_EXPAND_TRAIN_PER_BIT:=${RUN_LENGTH_FIXED_BINARY_ALPHA_EXPAND_TRAIN_PER_BIT}}"
: "${RUN_LENGTH_FIXED_BINARY_BEAM_COMPOSITION_PATH_MODE:=${RUN_LENGTH_FIXED_BINARY_ALPHA_COMPOSITION_PATH_MODE}}"
