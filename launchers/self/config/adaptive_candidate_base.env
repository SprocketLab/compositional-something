# Default-only adaptive candidate-training settings shared by task configs.
# Source through ADAPTIVE_CONFIG_FILE/ADAPTIVE_CONFIG_FILES. Caller env wins.

: "${MODEL_NAME:=Qwen/Qwen3-1.7B}"
: "${PROPOSAL_MODEL_NAME:=current}"
: "${CONDITION:=config}"
: "${PROPOSAL_OUTPUT_SCHEMA:=action_prediction}"
: "${NUM_ROUNDS:=100}"
: "${NUM_CANDIDATES:=8}"
: "${MAX_STEPS:=0}"
: "${TRAIN_BATCH_SIZE:=16}"
: "${EVAL_BATCH_SIZE:=16}"
: "${GRAD_ACCUM_STEPS:=1}"
: "${LEARNING_RATE:=5e-6}"
: "${CONTROLLER_EXECUTION_MODE:=local}"
: "${CANDIDATE_EXECUTION_MODE:=local_parallel}"
: "${CANDIDATE_LOCAL_PARALLELISM:=4}"
: "${LAMBDA_FINAL:=0.1}"
: "${SELECTION_MIN_REWARD:=0.0}"
: "${OUTCOME_TRACE_TARGET_MODE:=numeric}"
: "${OUTCOME_TRACE_REPLAY_RATIO:=0.10}"
: "${OUTCOME_TRACE_REPLAY_MAX_EXAMPLES:=4096}"
: "${PROPOSAL_GRPO_LEARNING_RATE:=1e-6}"
: "${PROPOSAL_GRPO_KL_COEF:=0.01}"
: "${PROPOSAL_GRPO_GRAD_CLIP:=1.0}"
: "${PROPOSAL_GRPO_ZERO_VARIANCE:=fixed_baseline}"
: "${PROPOSAL_GRPO_REWARD_MODE:=outcome}"
: "${PROPOSAL_GRPO_OUTCOME_SCALE:=0.05}"
: "${PROPOSAL_GRPO_FIXED_BASELINE:=0.5}"
: "${KEEP_ALL_PROPOSAL_GRPO_CHECKPOINTS:=0}"
: "${RUN_COMPILE_CHECK:=1}"
: "${REPAIR_ATTEMPTS:=1}"
