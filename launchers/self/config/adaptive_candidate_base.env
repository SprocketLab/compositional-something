# Default-only adaptive candidate-training settings shared by task configs.
# Source through ADAPTIVE_CONFIG_FILE/ADAPTIVE_CONFIG_FILES. Caller env wins.

: "${MODEL_NAME:=Qwen/Qwen3-1.7B}"
: "${PROPOSAL_MODEL_NAME:=current}"
# Set TREAT_SEED_AS_ROUND_ZERO=1 only when MODEL_NAME points to a
# pre-trained seed checkpoint. In that mode attempt 1 proposes from MODEL_NAME
# directly after round-0 evaluation, skipping seed-stage training.
: "${TREAT_SEED_AS_ROUND_ZERO:=0}"
: "${CONDITION:=config}"
: "${PROPOSAL_OUTPUT_SCHEMA:=action_observation}"
: "${PROPOSAL_PROMPT_ACTION_HISTORY:=1}"
: "${PROPOSAL_PROMPT_ACTION_HISTORY_MAX_ITEMS:=5}"
: "${NUM_CANDIDATES:=8}"
: "${PROPOSAL_TEMPERATURE:=0.9}"
: "${PROPOSAL_TOP_P:=0.95}"
: "${PROPOSAL_SAMPLING_BATCH_SIZE:=8}"
: "${FORCE_UNIQUE_PROPOSALS:=1}"
: "${PROPOSAL_UNIQUE_MAX_DRAWS:=0}"
: "${MAX_STEPS:=100}"
: "${SEED_MAX_STEPS:=0}"
: "${TRAIN_BATCH_SIZE:=16}"
: "${EVAL_BATCH_SIZE:=128}"
: "${GRAD_ACCUM_STEPS:=1}"
: "${LEARNING_RATE:=5e-6}"
: "${CONTROLLER_EXECUTION_MODE:=local}"
: "${CANDIDATE_EXECUTION_MODE:=local_parallel}"
: "${CANDIDATE_LOCAL_PARALLELISM:=2}"
: "${CANDIDATE_LOCAL_PACK_SIZE:=2}"
: "${CANDIDATE_LOCAL_CACHE_BASE_STATE:=1}"
: "${LAMBDA_FINAL:=0.1}"
: "${SELECTION_MIN_REWARD:=0.0}"
: "${SOURCE_ADMISSION_TARGET_ACCURACY_THRESHOLD:=0.80}"
: "${OUTCOME_TRACE_TARGET_MODE:=numeric}"
: "${OUTCOME_TRACE_REPLAY_RATIO:=0.10}"
: "${OUTCOME_TRACE_REPLAY_MAX_EXAMPLES:=4096}"
: "${PROPOSAL_OBSERVATION_LOSS_WEIGHT:=0.2}"
: "${PROPOSAL_FORMAT_LOSS_WEIGHT:=0.02}"
: "${PROPOSAL_FORMAT_REPLAY_MAX_EXAMPLES:=256}"
: "${PROPOSAL_GRPO_DEDUPLICATE_ACTIONS:=1}"
: "${PROPOSAL_GRPO_SPAN:=reasoning_action}"
: "${PROPOSAL_UPDATE_MICROBATCH_SIZE:=8}"
: "${PROPOSAL_GRPO_LEARNING_RATE:=1e-6}"
: "${PROPOSAL_GRPO_KL_COEF:=0.01}"
: "${PROPOSAL_GRPO_GRAD_CLIP:=1.0}"
: "${PROPOSAL_GRPO_ZERO_VARIANCE:=skip}"
: "${PROPOSAL_GRPO_REWARD_MODE:=outcome}"
: "${PROPOSAL_GRPO_OUTCOME_SCALE:=0.05}"
: "${PROPOSAL_GRPO_FIXED_BASELINE:=0.5}"
: "${PROPOSAL_GRPO_NOVELTY_BONUS_BETA:=0.05}"
: "${KEEP_FINAL_MODEL_CHECKPOINT:=0}"
: "${KEEP_ALL_PROPOSAL_GRPO_CHECKPOINTS:=0}"
: "${RUN_COMPILE_CHECK:=1}"
