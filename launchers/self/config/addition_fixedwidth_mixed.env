# Default baseline sets for submit_addition_fixedwidth_mixed_mig.sh.
#
# Override these variables in the environment or point ADDITION_MIXED_CONFIG at
# another file to run a smaller/larger baseline matrix without editing the
# submitter.

ADDITION_MIXED_BASELINES_RAW="${ADDITION_MIXED_BASELINES_RAW:-short_only direct with_carry with_carry_filtered}"
ADDITION_MIXED_ORIGINAL_COMPOSITION_BASELINES_RAW="${ADDITION_MIXED_ORIGINAL_COMPOSITION_BASELINES_RAW:-direct with_carry with_carry_filtered}"
