# Default task metadata for the Figure 2 recipe workflow.
#
# These values are sourced by run_figure2_recipe_aggressive.sh through
# launchers/self/lib/figure2_recipe_common.sh. Environment variables exported
# before launching still take precedence because each assignment is guarded.

FIGURE2_RUN_LENGTH_MODULE="${FIGURE2_RUN_LENGTH_MODULE:-self.run_length_self_improvement}"
FIGURE2_RUN_LENGTH_SEED_MODEL_DEFAULT="${FIGURE2_RUN_LENGTH_SEED_MODEL_DEFAULT:-${ROOT_DIR}/artifacts/models/run_length_recipe_seed_best}"
FIGURE2_RUN_LENGTH_ARCHIVED_RESULTS_PATH="${FIGURE2_RUN_LENGTH_ARCHIVED_RESULTS_PATH:-${ROOT_DIR}/artifacts/runs/self_improvement_refocus_20260416_bitpatched2/run_length/compose/self_improvement_results.json}"
FIGURE2_RUN_LENGTH_DEFAULT_EXPAND_NUM_BITS="${FIGURE2_RUN_LENGTH_DEFAULT_EXPAND_NUM_BITS:-4}"
