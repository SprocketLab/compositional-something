# Default settings for submit_addition_fullpack_filtered_mig.sh.
#
# Override variables in the environment, or point
# ADDITION_FULLPACK_FILTERED_CONFIG at another file, to adjust this pack without
# editing the submitter.

: "${JOB_SCRIPT:=${ROOT_DIR}/launchers/self/run_addition_fullpack_filtered.sbatch}"
: "${LOG_DIR:=${ROOT_DIR}/artifacts/logs}"
: "${DRY_RUN:=0}"
: "${ADDITION_FULLPACK_FILTERED_BASELINES_RAW:=${BASELINES:-short_only direct with_carry with_carry_filtered compose_corrupt}}"
