# Default Stage 1 grid for submit_addition_fixedwidth_moredata_mig.sh.
#
# Rows are:
#   composition_path_mode:expand_train_per_digit:max_steps:stable_steps:decay_steps
# Override ADDITION_MOREDATA_SCHEDULE_ROWS_RAW or point ADDITION_MOREDATA_CONFIG
# at another file to adjust the sweep without editing the launcher.

ADDITION_MOREDATA_SCHEDULE_ROWS_RAW="${ADDITION_MOREDATA_SCHEDULE_ROWS_RAW:-fixed_binary:20000:4500:3500:1000 fixed_binary:40000:6000:5000:1000 random:20000:4500:3500:1000 random:40000:6000:5000:1000}"
